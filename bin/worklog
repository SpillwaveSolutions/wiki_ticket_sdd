#!/usr/bin/env python3
"""
worklog -- CLI entry point. WORKLOG-SPEC section 12.

Implemented: add, update, close, reopen, link, show, list, fold, plan-capture,
             roadmap-render, roadmap-snapshot, wiki-add, compact,
             status (daily|weekly|timecard),
             ingest, conflict, resolve (pull side, sections 10.2 and 10.6),
             sync (dispatcher: bin/sync_dispatch.py), adapter init|check,
             dedupe (marker copies on the tracker; default dry-run),
             promote (classifier suggestion -> create event, taxonomy §6.4),
             adr new|list|check (docs/adr, bin/adr.py, schema/adr.schema.json).
No stubs remain.

Taxonomy (docs/plans/2026-07-18-work-taxonomy.md): items carry `level`
(epic|story|task|subtask), `kind` (feature|bug|ops|triage) and `milestone`
instead of the old single `type`. `--type` survives as a deprecated alias.
Write-time rules enforced here (§2): epics are feature/ops only; milestone
lives on leaves; a create without --kind deliberately omits kind so the fold
triages it (never silently `feature`).

Nothing else in the repo may write to .work/*.jsonl (invariant 15.4).
"""
import argparse, glob, json, os, re, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import ulid
import item_fields
from fold import (fold, FoldResult, read_lines, dedupe_and_sort, external_owners,
                  OPEN_STATUSES, CLOSED_STATUSES, LEGACY_TYPE_MAP)

LOG = ".work/todo.jsonl"
PATHS = (".work/todo.jsonl", ".work/done.jsonl")
MAX_BODY = 2048  # derived from PIPE_BUF (section 8.3). Not a setting.
VERSION = "0.24.8"  # kept in step with plugin/.claude-plugin/plugin.json by tests/test_plugin.py


_warned_concurrent = False


def _warn_concurrent_sessions():
    """Advisory (#236). Once per process, on stderr, never blocking.

    Sits in append() rather than in each command: every write in the system
    funnels through here, so one guard covers add/update/close/link/ingest
    and anything added later, and no caller can forget it.
    """
    global _warned_concurrent
    if _warned_concurrent or os.environ.get("WORKLOG_NO_SESSION_WARN"):
        return
    _warned_concurrent = True
    try:
        import session
        note = session.warning()
    except Exception:
        return          # an advisory must never break a write
    if note:
        print(f"worklog: WARNING — {note}", file=sys.stderr)


def append(event):
    """The only writer. Single O_APPEND write, always newline-terminated.

    Also self-heals a missing trailing newline on the existing file (a hand
    edit the hook hasn't caught yet): appending without the repair would fuse
    two events into one unparseable line and lose both (section 8.2).
    """
    if len(event.get("set", {}).get("body", "")) > MAX_BODY:
        sys.exit(f"worklog: body exceeds {MAX_BODY}B; put prose in the plan doc")
    _warn_concurrent_sessions()
    line = json.dumps(event, separators=(",", ":"), sort_keys=True) + "\n"
    fd = os.open(LOG, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        if os.fstat(fd).st_size:
            rfd = os.open(LOG, os.O_RDONLY)
            try:
                os.lseek(rfd, -1, os.SEEK_END)
                if os.read(rfd, 1) != b"\n":
                    line = "\n" + line
            finally:
                os.close(rfd)
        os.write(fd, line.encode())   # atomic under PIPE_BUF
    finally:
        os.close(fd)
    return event


def base(item, op, actor):
    """Every event the CLI writes starts here.

    `git` is provenance: the short HEAD sha this event was authored at, so
    two agents in different worktrees or branches produce traceably different
    events (01KYZNG520). It is a separate field on purpose -- the id must
    keep its full entropy, and an item's id is minted once, so only a
    per-event field can name where each event actually came from. Omitted
    entirely outside a git repo rather than written empty.
    """
    ev = {"ev": ulid.new(), "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
          "actor": actor, "item": item, "op": op}
    sha = ulid.git_commit()
    if sha:
        ev["git"] = sha
    return ev


LEVELS = ("epic", "story", "task", "subtask")
KINDS = ("feature", "bug", "ops", "triage")


def check_taxonomy(level, kind, milestone):
    """Write-time rules, taxonomy spec §2. The fold is lenient; this is not."""
    if level == "epic":
        if kind in ("bug", "triage"):
            sys.exit(f"worklog: an epic cannot be kind:{kind} — epics are "
                     "feature or ops (taxonomy §2.2)")
        if milestone is not None:
            sys.exit("worklog: milestone lives on leaves; epic milestones are "
                     "derived (taxonomy §2.5)")


ULID_RE = re.compile(r"^[0-9A-HJKMNP-TV-Z]{26}$")
ESTIMATES = ("XS", "S", "M", "L", "XL")


def parse_depends_on(raw, self_id=None):
    """Comma-separated ULIDs -> sorted list (worklog#256, spec §3.3).

    Shape is validated, existence is NOT: --parent does not check either, and
    an append-only log must stay writable when the thing you depend on is
    filed a minute later. Shape still matters -- five readers resolve these to
    titles, and a typo would render as a silent missing blocker rather than an
    error.

    Self-dependency IS rejected: an item that blocks itself can never be
    scheduled, and no ordering of the log makes it true later.
    """
    if not raw:
        return []
    out = []
    for tok in (t.strip() for t in raw.split(",")):
        if not tok:
            continue
        if not ULID_RE.match(tok):
            sys.exit(f"worklog: --depends-on {tok!r} is not a 26-char ULID; "
                     "dependencies are item ids, not ticket numbers or titles")
        if self_id and tok == self_id:
            sys.exit(f"worklog: {tok} cannot depend on itself")
        out.append(tok)
    return sorted(set(out))


def warn_ticket_refs(title):
    """Advisory only (worklog#242): a title cannot know its own ticket number
    -- the tracker mints that at the next sync -- so a `#123` in one is either
    a reference to a different ticket or a guess that will be wrong. Never a
    refusal: legitimate titles do cite other tickets."""
    import plan_capture
    refs = plan_capture.ticket_refs(title)
    if refs:
        print("worklog: WARNING — title cites %s; this item's own ticket "
              "number is assigned at sync, so cite the ULID instead if you "
              "meant this item" % ", ".join(refs), file=sys.stderr)


def cmd_add(a):
    if a.unplanned and not a.discovered_during:
        sys.exit("worklog: --unplanned requires --discovered-during (section 5.4)")
    if a.legacy_type is not None:
        # Faithful legacy alias: same (level, kind) mapping the fold applies
        # to old `type` events (§3.2) — bug -> task/bug, the rest -> feature.
        print("worklog: --type is deprecated; use --level/--kind", file=sys.stderr)
        lvl, knd = LEGACY_TYPE_MAP[a.legacy_type]
        a.level, a.kind = lvl, a.kind or knd
    check_taxonomy(a.level, a.kind, a.milestone)
    warn_ticket_refs(a.title)
    item = ulid.new()
    ev = base(item, "create", a.actor)
    # kind is only written when given: an omitted kind folds to triage (§2.3),
    # never silently to feature.
    ev["set"] = {k: v for k, v in {
        "level": a.level, "kind": a.kind, "milestone": a.milestone,
        "title": a.title, "status": "todo", "priority": a.priority,
        "body": a.body,
        "parent": a.parent, "plan": a.plan,
        "unplanned": True if a.unplanned else None,
        "discovered_during": a.discovered_during,
    }.items() if v is not None}
    # Optional fields (#108): only the ones this repo has switched on, and
    # only those the caller actually passed.
    ev["set"].update(item_fields.collect(a))
    deps = parse_depends_on(a.depends_on)
    if deps:
        ev["set"]["depends_on"] = deps
    if a.labels:
        ev["set"]["labels"] = a.labels.split(",")
    append(ev)
    print(item)


def _require_item(item):
    """Reject empty/whitespace item ids before any log write (worklog 01KXXMCG41).

    Whitespace inside an id is rejected too. `item` is a single positional, so
    `close "$id1 $id2"` writes an event against a composite key matching no
    item — a silent no-op that also renders a junk sidecar path. A real id
    never contains whitespace, so the same guard catches an error message
    captured into the id by mistake, which is how one of these arose.
    """
    if not item or not item.strip():
        sys.exit("worklog: empty item id")
    if len(item.split()) > 1:
        sys.exit(f"worklog: item id contains whitespace: {item[:60]!r}\n"
                 "  one item per invocation — loop instead: "
                 "for i in $ids; do worklog close \"$i\"; done")


def _resolve(item, r=None):
    """Resolve a full ULID or an unambiguous prefix to the real item
    (worklog 01KYA99TVC). Every command that names an existing item goes
    through here: close/update used to write events under the raw string, so
    the short id that `show`/`list` print minted a phantom orphan item instead
    of touching the real one, and update's taxonomy/closed-status guards ran
    against an empty dict.

    `r` lets a caller that needs the whole fold anyway (link's one-owner
    check) hand it in rather than folding the log twice -- the documented
    bulk-migration workflow links hundreds of items in a loop."""
    _require_item(item)
    r = r or fold([LOG, ".work/done.jsonl"])
    match = [i for k, i in r.items.items() if k.startswith(item)]
    if not match:
        sys.exit(f"worklog: no item matching {item}")
    if len(match) > 1:
        ids = ", ".join(sorted(i["id"] for i in match))
        sys.exit(f"worklog: {item} is ambiguous — matches {ids}")
    return match[0]


def cmd_update(a):
    cur = _resolve(a.item)
    if a.kind is not None or a.milestone is not None or a.status is not None:
        # §2 rules hold on update too, against the item's current level.
        check_taxonomy(cur.get("level"), a.kind, a.milestone)
        if a.status is not None and cur.get("status") in CLOSED_STATUSES:
            sys.exit(f"worklog: {cur['id']} is closed; use `worklog reopen` — "
                     "update --status would leave the stale resolution behind")
    ev = base(cur["id"], "update", a.actor)
    ev["set"] = {k: v for k, v in
                 {"status": a.status, "priority": a.priority, "title": a.title,
                  "body": a.body,
                  "kind": a.kind, "milestone": a.milestone}.items()
                 if v is not None}
    ev["set"].update(item_fields.collect(a))
    # depends_on is SET_VALUED in the fold, exactly like labels, so it takes
    # the same add/del shape rather than whole-field replacement -- two
    # branches each adding a blocker must both survive a union merge.
    add = {k: v for k, v in {
        "labels": a.add_label.split(",") if a.add_label else None,
        "depends_on": parse_depends_on(a.add_depends_on, cur["id"]) or None,
    }.items() if v}
    dele = {k: v for k, v in {
        "labels": a.del_label.split(",") if a.del_label else None,
        "depends_on": parse_depends_on(a.del_depends_on, None) or None,
    }.items() if v}
    if add:
        ev["add"] = add
    if dele:
        ev["del"] = dele
    if not (ev.get("set") or ev.get("add") or ev.get("del")):
        sys.exit("worklog: nothing to update")
    append(ev)


def cmd_close(a):
    item = _resolve(a.item)
    ev = base(item["id"], "close", a.actor)
    ev["set"] = {"status": a.status}
    if a.resolution:
        ev["set"]["resolution"] = a.resolution
    append(ev)


def cmd_reopen(a):
    """Emit the reopen op (spec §7): fold moves the item back to todo and
    drops the stale resolution — the pair `update --status todo` leaks."""
    item = _resolve(a.item)
    if item.get("status") not in CLOSED_STATUSES:
        sys.exit(f"worklog: {item['id']} is not closed "
                 f"(status {item.get('status')!r}); nothing to reopen")
    append(base(item["id"], "reopen", a.actor))
    print(item["id"])


def cmd_link(a):
    # Same phantom-item hazard as close/update: a link event under a prefix
    # mints an orphan carrying a real external key, which sync then pushes.
    r = fold([LOG, ".work/done.jsonl"])
    cur = _resolve(a.item, r)
    # One remote ticket, one local owner (github#226). Status-blind on purpose:
    # a CLOSED owner is among the most dangerous, because sync pushes a full
    # update against its key and then closes the ticket -- that is what marked
    # the reported ticket Done. Guarding only open items would wave the same
    # bug through with the two commands reordered (cancel first, then link).
    # Self-excluded: re-linking an item to the key it already owns is normal
    # (refreshing --url/--rev, re-running a partial migration, sync's own
    # auto-link after a create).
    if not a.force:
        others = [i for i in external_owners(r.items.values())
                  .get((a.system, str(a.key)), []) if i != cur["id"]]
        if others:
            owner = r.items[others[0]]
            sys.exit(
                f"worklog: {a.system}:{a.key} already belongs to {owner['id']}\n"
                f"  ({owner.get('title', '')!r}) — two items owning one ticket makes "
                "every sync\n  overwrite it with whichever changed last (github#226).\n"
                "To move it:\n"
                f"  worklog unlink {owner['id']}\n"
                f"  worklog link {cur['id']} --system {a.system} --key {a.key}")
    ev = base(cur["id"], "link", a.actor)
    ev["set"] = {"external": {k: v for k, v in {
        "system": a.system, "key": a.key, "url": a.url, "rev": a.rev,
        "hash": a.hash,
        "synced_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }.items() if v is not None}}
    append(ev)


def cmd_unlink(a):
    """Retract a link, so a mistaken one is correctable by appending -- which
    is the whole point of an append-only log, and the one case where it was
    not possible (github#226).

    No new fold op: `link` already falls through to _apply_mutations, which
    does whole-field last-writer-wins on `external`, so an EMPTY external is
    the retraction. A clone running an older fold applies it correctly too.

    {} and never null: cmd_list's reader is `.get("external", {})`, whose
    default never fires when the key exists with a None value -- null there
    would raise AttributeError for every `worklog list` in the repo.
    """
    cur = _resolve(a.item)
    ext = cur.get("external") or {}
    if not ext.get("key"):
        sys.exit(f"worklog: {cur['id']} has no external link; nothing to unlink")
    ev = base(cur["id"], "link", a.actor)
    ev["set"] = {"external": {}}
    append(ev)
    print(f"unlinked {cur['id']} from {ext.get('system')}:{ext['key']}")
    # Intentional unlink vs lost-link (#382): last_pushed_key is what stops
    # a checkout-reverted link from minting a second ticket, so a deliberate
    # unlink MUST forget it or the next sync would just re-attach.
    try:
        with open(".work/sync-state.json", encoding="utf-8") as fh:
            st = json.load(fh)
        item_st = st.get("items", {}).get(cur["id"])
        if item_st:
            item_st["last_pushed_key"] = None
            item_st["last_pushed_hash"] = None
            item_st.pop("gone_key", None)
            with open(".work/sync-state.json", "w", encoding="utf-8") as fh:
                json.dump(st, fh, indent=2, sort_keys=True)
                fh.write("\n")
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass
    # The log is only half of it: trackers that merge rather than overwrite
    # (ADO tags) leave the marker behind, and the next pull can still attribute
    # a remote change to this ULID.
    print(f"note: {ext.get('system')}:{ext['key']} may still carry the marker "
          f"worklog:{cur['id']} — remove it in the tracker", file=sys.stderr)


INGEST_FIELDS = ("title", "body", "status", "priority", "assignee", "type",
                 "level", "kind", "milestone")
STATUSES = OPEN_STATUSES + CLOSED_STATUSES
PRIORITIES = ("P0", "P1", "P2", "P3")


def cmd_ingest(a):
    """Ingest a remote change (section 10.2). `ev` is deterministic and `ts`
    is the REMOTE clock, so two devs polling the same change append
    byte-identical lines and the fold dedupes them to one."""
    _require_item(a.item)
    ev = {"ev": ulid.deterministic(a.system, a.key, a.rev, a.rev_ts_ms),
          "ts": _rfc3339(a.rev_ts_ms), "actor": a.system, "item": a.item,
          "op": "update",
          "src": {"system": a.system, "key": a.key, "rev": a.rev}}
    sets = {}
    for pair in a.set or []:
        field, eq, value = pair.partition("=")
        if not eq:
            sys.exit(f"worklog: bad --set {pair!r}; want field=value")
        if field not in INGEST_FIELDS:
            sys.exit(f"worklog: ingest cannot set {field!r} "
                     f"(allowed: {', '.join(INGEST_FIELDS)})")
        if field == "status" and value not in STATUSES:
            sys.exit(f"worklog: bad status {value!r}")
        if field == "priority" and value not in PRIORITIES:
            sys.exit(f"worklog: bad priority {value!r}")
        if field == "level" and value not in LEVELS:
            sys.exit(f"worklog: bad level {value!r}")
        if field == "kind" and value not in KINDS:
            sys.exit(f"worklog: bad kind {value!r}")
        sets[field] = value
    if sets:
        ev["set"] = sets
    if a.add_label:
        ev["add"] = {"labels": sorted(a.add_label.split(","))}
    if a.del_label:
        ev["del"] = {"labels": sorted(a.del_label.split(","))}
    if not (sets or a.add_label or a.del_label):
        sys.exit("worklog: nothing to ingest")
    append(ev)
    print(ev["ev"])


def _check_conflictable_field(field):
    """#240: `id` is identity, not data, and `external` is a structured link
    (system/key/url/rev), not a string -- writing either through conflict/
    resolve corrupts the next sync. Reuse INGEST_FIELDS: it is already the
    set of fields a remote is allowed to disagree about."""
    if field not in INGEST_FIELDS:
        sys.exit(f"worklog: field {field!r} cannot be used with conflict/resolve "
                 f"(allowed: {', '.join(INGEST_FIELDS)})")


def cmd_conflict(a):
    """Record a both-sides-changed field (section 10.6). State never changes;
    the fold files it under _conflicts until a later write clears it."""
    _require_item(a.item)
    _check_conflictable_field(a.field)
    ev = base(a.item, "conflict", "sync")
    ev["set"] = {"field": a.field, "local": a.local, "remote": a.remote,
                 "remote_rev": a.remote_rev}
    append(ev)


def cmd_resolve(a):
    """Resolve the last open conflict on a field with a normal update event.
    The update outsorts the conflict, so the fold clears it (section 10.6)."""
    _check_conflictable_field(a.field)
    item = _resolve(a.item)
    open_c = [c for c in item.get("_conflicts", []) if c.get("field") == a.field]
    if not open_c:
        sys.exit(f"worklog: no open conflict on {a.field} for {a.item}")
    old = item.get(a.field)
    new = old if a.take == "local" else open_c[-1].get("remote")
    ev = base(item["id"], "update", a.actor)
    ev["set"] = {a.field: new}
    append(ev)
    print(f"{a.field}: {old} -> {new} (took {a.take})")


PUBLISHED = ".work/published.json"


def _register_published(key, file, title):
    """Register a file in the wiki publish set. published.json is a plain JSON
    map (spec 9.2), not an event log, so direct load/dump is allowed here."""
    published = {}
    if os.path.exists(PUBLISHED):
        with open(PUBLISHED, encoding="utf-8") as fh:
            published = json.load(fh)
    # Preserve url/rev/source_hash on re-register: wiping them would make the
    # next publish create a duplicate page (spec 9.2).
    entry = published.setdefault(key, {"url": None, "rev": None,
                                       "source_hash": None})
    entry["source"] = file
    entry["title"] = title
    os.makedirs(os.path.dirname(PUBLISHED), exist_ok=True)
    with open(PUBLISHED, "w", encoding="utf-8") as fh:
        json.dump(published, fh, indent=2, sort_keys=True)
        fh.write("\n")


def cmd_wiki_add(a):
    if not os.path.exists(a.file):
        sys.exit(f"worklog: {a.file} not found")
    _register_published(a.key, a.file, a.title)
    print(a.key)


def cmd_list(a):
    r = fold([LOG, ".work/done.jsonl"])
    items = r.open_items() if not a.all else list(r.items.values())
    for i in sorted(items, key=lambda x: (x.get("priority", "P9"), x["id"])):
        # `or {}` not a .get default: unlink writes {} and a merge can leave a
        # null, and the default never fires when the key exists.
        ext = (i.get("external") or {}).get("key", "-")
        print(f"{i['id'][:8]}  {i.get('priority','--'):3}  {i.get('status','?'):12} "
              f"{ext:10} {i.get('title','')}")
    if r.conflicts():
        print(f"\n{len(r.conflicts())} conflict(s) need attention: worklog show <id>",
              file=sys.stderr)


def cmd_show(a):
    print(json.dumps(_resolve(a.item), indent=2))


def cmd_fold(a):
    r = fold([LOG, ".work/done.jsonl"])
    print(json.dumps(sorted(r.items.values(), key=lambda i: i["id"]), indent=2))


def cmd_roadmap_render(a):
    import render_roadmap
    # --viz default matches render()'s default: the pre-commit hook diffs the
    # bare-script output against the file this writes.
    md = render_roadmap.render(viz="none" if a.no_viz else a.viz)
    os.makedirs("docs", exist_ok=True)
    with open("docs/roadmap.md", "w", encoding="utf-8") as fh:
        fh.write(md)
    print("docs/roadmap.md")


def cmd_roadmap_snapshot(a):
    import re
    import shutil
    if not os.path.exists("docs/roadmap.md"):
        sys.exit("worklog: docs/roadmap.md not found; run roadmap-render first")
    with open("docs/roadmap.md", encoding="utf-8") as fh:
        on_disk = fh.read()
    # #221: a snapshot freezes docs/roadmap.md forever, so a stale copy stays
    # wrong forever. render() is a pure/deterministic function of the log
    # (render_roadmap.py docstring), so regenerating is a no-op when the file
    # is already fresh and self-healing when the log moved on since the last
    # `roadmap-render`. Only do this for a file that carries our own
    # source_hash marker -- anything else was never ours to regenerate.
    m = re.search(r"^source_hash: (\S+)$", on_disk, re.MULTILINE)
    if m:
        import render_roadmap
        fresh = render_roadmap.render()
        fresh_hash = re.search(r"^source_hash: (\S+)$", fresh, re.MULTILINE).group(1)
        if fresh_hash != m.group(1):
            with open("docs/roadmap.md", "w", encoding="utf-8") as fh:
                fh.write(fresh)
    date = time.strftime("%Y-%m-%d", time.gmtime())
    name = f"{date}_{a.name}" if a.name else date
    path = f"docs/roadmap/{name}.md"
    if os.path.exists(path):
        sys.exit(f"worklog: {path} exists; snapshots are frozen "
                 "— pick a new --name")
    os.makedirs("docs/roadmap", exist_ok=True)
    shutil.copyfile("docs/roadmap.md", path)
    # restamp the copy's identity before it freezes: this page is a snapshot,
    # not the live roadmap (plan ia-content-model §5.4)
    import ia
    fields = {"wiki_key": f"roadmap-snapshot/{name}",
              "doc_type": "roadmap-snapshot", "truth_state": "snapshot",
              "date": date}
    if a.name:
        fields["name"] = a.name
    ia.ensure_front_matter_fields(path, fields)
    print(path)


def cmd_plan_capture(a):
    import plan_capture
    draft = open(a.file, encoding="utf-8").read() if a.file else sys.stdin.read()
    tasks = plan_capture.parse_tasks(draft)
    if not tasks:
        sys.exit("worklog: no '- [ ]' tasks found under a '## Tasks' heading")
    for t in tasks:
        warn_ticket_refs(t["title"])
    date = time.strftime("%Y-%m-%d", time.gmtime())
    path = f"docs/plans/{date}-{a.slug}.md"
    # Invariant 15.8 is about the SLUG, not the filename: "pick a new slug to
    # supersede". Checking only today's path enforced that by accident and missed
    # whenever the date differed. The date here is UTC while a plan is authored in
    # local time, so a plan written on a US evening and captured minutes later
    # looks for tomorrow's filename, finds nothing, and silently writes a second
    # copy of the same plan. Observed 2026-07-26 in a downstream repo: a plan
    # authored as 2026-07-26-<slug>.md was duplicated as 2026-07-27-<slug>.md.
    # A raw `*-<slug>.md` glob matches by suffix, not by field boundary: a
    # search for slug "migration" also matches an existing
    # "2026-07-01-database-migration.md" (real slug "database-migration"),
    # since that filename also ends in "-migration.md" — a false-positive
    # refusal of a legitimately new, different slug. Anchor on the fixed
    # YYYY-MM-DD date shape so only an exact slug match counts.
    slug_re = re.compile(r"^\d{4}-\d{2}-\d{2}-%s\.md$" % re.escape(a.slug))
    existing = sorted(p for p in glob.glob("docs/plans/*.md")
                      if slug_re.match(os.path.basename(p)))
    if existing:
        sys.exit(f"worklog: {existing[0]} already captures slug '{a.slug}'; plans "
                 "are never rewritten (invariant 15.8) — pick a new slug to "
                 "supersede")

    # Captured items get explicit kind:feature — a plan is deliberate feature
    # work, not a triage candidate (taxonomy §2.3 exemption by intent).
    epic_id = ulid.new()
    ev = base(epic_id, "create", a.actor)
    ev["set"] = {"level": "epic", "kind": "feature", "title": a.title,
                 "status": "todo", "priority": a.priority, "plan": path}
    if a.body:
        ev["set"]["body"] = a.body
    append(ev)

    item_ids, last_task = [], epic_id
    for t in tasks:
        iid = ulid.new()
        ev = base(iid, "create", a.actor)
        ev["set"] = {"level": "subtask" if t["subtask"] else "task",
                     "kind": "feature",
                     "title": t["title"], "status": "todo",
                     "priority": t["priority"],
                     "parent": last_task if t["subtask"] else epic_id,
                     "plan": path}
        if t.get("body"):
            ev["set"]["body"] = t["body"]
        append(ev)
        item_ids.append(iid)
        if not t["subtask"]:
            last_task = iid

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(plan_capture.front_matter(date, a.slug, a.title, epic_id,
                                           item_ids, ulid.git_commit_full()))
        fh.write(draft)
    print(path)
    print(epic_id)


SUGGESTIONS = ".work/suggestions.jsonl"


def cmd_promote(a):
    """Promote a classifier suggestion into exactly ONE create event
    (taxonomy spec §6.4). The suggestion is then marked consumed in
    suggestions.jsonl so the classifier gate dedupes against it."""
    try:
        fh = open(SUGGESTIONS, encoding="utf-8")
    except FileNotFoundError:
        sys.exit(f"worklog: {SUGGESTIONS} not found — no suggestions to "
                 "promote (the classifier writes it; see taxonomy spec §6)")
    records, consumed = {}, set()
    with fh:
        for line in fh:
            if not line.strip():
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                continue  # staging file is best-effort; skip bad lines
            sid = rec.get("suggestion_id")
            if rec.get("consumed"):
                consumed.add(sid)
            elif "proposed" in rec:
                records.setdefault(sid, rec)
    if a.suggestion_id in consumed:
        sys.exit(f"worklog: suggestion {a.suggestion_id} already consumed")
    if a.suggestion_id not in records:
        sys.exit(f"worklog: no suggestion {a.suggestion_id} in {SUGGESTIONS}")
    prop = records[a.suggestion_id].get("proposed") or {}
    level = prop.get("level", "task")
    kind = prop.get("kind")  # honored as proposed, including triage
    check_taxonomy(level, kind, prop.get("milestone"))
    item = ulid.new()
    ev = base(item, "create", a.actor)
    ev["set"] = {k: v for k, v in {
        "level": level, "kind": kind, "milestone": prop.get("milestone"),
        "title": prop.get("title"), "status": "todo",
        "parent": prop.get("parent"),
    }.items() if v is not None}
    append(ev)
    with open(SUGGESTIONS, "a", encoding="utf-8") as out:
        out.write(json.dumps({"consumed": True,
                              "suggestion_id": a.suggestion_id,
                              "item": item},
                             separators=(",", ":"), sort_keys=True) + "\n")
    print(item)


def cmd_adr_new(a):
    """Scaffold docs/adr/NNNN-slug.md and register it for wiki publish.
    ADR bodies are written once (Nygard); --supersedes N performs the one
    sanctioned mutation on ADR N: status + superseded_by only."""
    import re
    import adr
    ids = {}
    for path in adr.adr_files():
        m = re.match(r"(\d{4})-", os.path.basename(path))
        if m:
            ids[int(m.group(1))] = path
    nid = max(ids) + 1 if ids else 1
    slug = re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")[:40].rstrip("-")
    if not slug:
        sys.exit("worklog: title yields an empty slug")
    date = time.strftime("%Y-%m-%d", time.gmtime())
    path, content = adr.scaffold(
        a.title, nid, slug, date, status=a.status,
        deciders=a.deciders.split(",") if a.deciders else None,
        tags=a.tags.split(",") if a.tags else None,
        supersedes=a.supersedes, git_hash=ulid.git_commit_full())
    if os.path.exists(path):
        sys.exit(f"worklog: {path} exists")
    if a.supersedes is not None:
        old = ids.get(a.supersedes)
        if not old:
            sys.exit(f"worklog: no ADR {a.supersedes:04d} to supersede")
        adr.mark_superseded(old, nid)
    os.makedirs(adr.ADR_DIR, exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    key = f"adr/{nid:04d}-{slug}"
    _register_published(key, path, f"ADR-{nid:04d}-{slug}")
    print(path)


def cmd_adr_list(a):
    import adr
    rows = []
    for path in adr.adr_files():
        with open(path, encoding="utf-8") as fh:
            try:
                meta, _ = adr.parse_front_matter(fh.read())
            except ValueError:
                continue  # adr check names it; the listing stays best-effort
        rows.append(meta)
    for m in sorted(rows, key=lambda m: m.get("id") or 0):
        print(f"{m.get('id') or 0:04d}  {m.get('status','?'):10}  "
              f"{m.get('title','')}")


def cmd_adr_check(a):
    import adr
    problems = adr.check_all()
    for pr in problems:
        print(pr)
    if problems:
        sys.exit(1)
    print(f"adr: {len(adr.adr_files())} records ok")


def cmd_wiki_key(a):
