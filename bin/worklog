        for rec in proposed:
            pe = rec["proposed_edge"]
            print(f"proposed: {pe['from']} -{pe['type']}-> {pe['target']} "
                  f"({rec['suggestion_id']})")
        print(f"ia: {len(proposed)} edge suggestion(s) -> {ia_graph.SUGGESTIONS} "
              "(confirm by adding relates_to to the doc's sidecar)")
        return
    g = ia_graph.write_graph()
    print(f"ia: {len(g['nodes'])} nodes, {len(g['edges'])} edges -> {ia_graph.GRAPH}")


