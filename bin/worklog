if __name__ == "__main__":
    args = p.parse_args()
    if not getattr(args, "actor", None):
        args.actor = (
            (os.environ.get("SECOND_BRAIN_IDENTITY") or "").strip()
            or os.environ.get("USER")
            or "unknown"
        )
    args.fn(args)
