    if not key:
        sys.exit(f"worklog: {a.path} is outside the content model "
                 "(docs/plans, roadmap, status, designs, adr, user_guide)")
    print(key)
    if a.verbose:
        print(f"canonical: {canonical}")
        if aliases:
            print(f"aliases: {', '.join(aliases)}")


def cmd_ia_normalize(a):
    import ia
    changes = ia.normalize(check=a.check)
    for c in changes:
        print(("needs: " if a.check else "wrote: ") + c)
    if a.check and changes:
        sys.exit(1)
    if not changes:
        print("ia: everything normalized (no-op)")
    elif not a.check:
        print(f"ia: {len(changes)} normalization(s) applied")


def cmd_ia_render(a):
    import ia_render
    changed = ia_render.write_all(check=a.check)
    for path in changed:
        print(("stale: " if a.check else "wrote: ") + path)
    if a.check and changed:
        sys.exit(1)
    if not changed:
        print("ia: rendered pages, manifest, aliases all fresh")


