    except ValueError as e:
        sys.exit(f"worklog: {e}")
    print(f"pr/{meta['number']}: {meta['state']} · review {meta['review']} "
          f"· checks {meta['checks']} · {len(meta['files'])} file(s)")


def cmd_provenance_backfill(a):
    """Stamp `merged_in` on frozen docs that have landed (plan
    2026-08-03-doc-provenance-and-verification). Imported lazily: this is
    the one provenance path that shells out to git, and keeping it out of
    module scope keeps the import graph of the render plane clean."""
    import provenance
    changed = provenance.backfill(check=a.check)
    provenance.report(changed, check=a.check)
    if a.check and changed:
        sys.exit(1)


def cmd_doc_verify(a):
    """Resolve each document's code citations at the commit it was written
    against (#294). Lazy import: doc_verify shells out to git, and the
    render plane must not grow that dependency."""
    import doc_verify
    only = None
    if getattr(a, "staged", False):
        only = doc_verify.staged_docs()
        # None and empty mean different things and must not be conflated:
        # None is "no staged set to speak of", empty is "this commit touches
        # no documents". Treating None as empty exits 0 on a check that never
        # ran -- a pass it never earned.
        if only is None:
            print("doc-verify: cannot read the staged set; "
                  "checking every document")
        elif not only:
            print("doc-verify: this commit touches no documents")
            return
    findings, summary = doc_verify.verify(strict=a.strict, only=only)
    doc_verify.report(findings, summary)
    if a.strict:
        bad = doc_verify.failing(findings)
        if bad:
            print("doc-verify: %d finding(s) fail --strict "
                  "(fabrication in a document that can still be fixed, or "
                  "drift on a doc claiming to describe HEAD)" % len(bad))
            sys.exit(1)


def cmd_trace_check(a):
    import ia_graph
    gaps = ia_graph.trace_check(strict=a.strict)
    for g in gaps:
        print(g)
    if gaps:
        print(f"trace: {len(gaps)} unlinked-evidence gap(s)")
        if a.strict:
            sys.exit(1)
    else:
        print("trace: no unlinked evidence")


