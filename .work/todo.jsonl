{"actor":"richardhightower","ev":"01M2XCWMVEH3XFP2VPS9JBD6XE","git":"0c94b21","item":"01M2XCWMVEH3XFP2VPS9JBD6XD","op":"create","set":{"body":"Read-only permissions in worklog.yml, remove the dead bypass actor from the ruleset and apply the ruleset live with gh api, and write ADR-0011 that supersedes ADR-0010 with the PR-landing path and the PAT decision.","kind":"feature","level":"task","parent":"01M2XCWMV0QYM4ZRBWN1V1327B","plan":"docs/plans/2026-09-19-review-v0-24-10-and-open-tickets.md","priority":"P1","status":"todo","title":"Interim merge-gate hardening and ADR-0011"},"ts":"2026-09-19T17:54:39Z"}
