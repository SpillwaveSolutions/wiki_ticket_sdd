# Subprocess-aware coverage: suites exercise the CLI via
# `python3 bin/wiki-ticket/worklog ...` in sandbox copies.
# COVERAGE_PROCESS_START + a site .pth start coverage in every subprocess;
# [paths] maps sandbox copies back onto bin/wiki-ticket at combine time.
[run]
parallel = True
source = bin/wiki-ticket

[paths]
bin/wiki-ticket =
    bin/wiki-ticket
    */bin/wiki-ticket
